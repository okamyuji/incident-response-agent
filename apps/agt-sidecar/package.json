{
  "name": "agt-sidecar",
  "version": "1.0.0",
  "description": "Agent Governance Toolkit egress proxy sidecar (TypeScript/Express)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsc && tsc-alias",
    "clean": "rm -rf dist coverage",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "pnpm format:check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "^0.75.0",
    "supertest": "7.3.1",
    "tsc-alias": "1.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}

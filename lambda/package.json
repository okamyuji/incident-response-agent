{
  "name": "@ira/lambdas",
  "version": "1.0.0",
  "description": "Bedrock-invoking Lambda functions (Haiku / Sonnet / Opus)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "package": "pnpm build && node scripts/zip.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1068.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1068.0",
    "@aws-sdk/client-dynamodb": "3.1068.0",
    "@aws-sdk/client-sns": "3.1068.0",
    "@aws-sdk/lib-dynamodb": "3.1068.0",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.161",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "^0.74.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
